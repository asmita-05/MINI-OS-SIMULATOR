# ─────────────────────────────────────────────────────────────────────────────
#  demo_basic.ossim
#  Basic scheduling demonstration script for Mini OS Simulator.
#  Run with:  run scripts/demo_basic.ossim
# ─────────────────────────────────────────────────────────────────────────────

# Step 1 — Create five classic textbook processes
proc add Alpha   0 10 3
proc add Beta    1  4 1
proc add Gamma   2  6 4
proc add Delta   3  8 2
proc add Epsilon 4  2 5

# List them
proc list

# Step 2 — Run FCFS
sched set fcfs
sched run

# Step 3 — Run SJF
sched set sjf
sched run

# Step 4 — Run SRTF (preemptive SJF)
sched set srtf
sched run

# Step 5 — Round Robin Q=3
sched set rr 3
sched run

# Step 6 — Priority non-preemptive
sched set priority
sched run

# Step 7 — Compare all at once
compare --quantum 3
