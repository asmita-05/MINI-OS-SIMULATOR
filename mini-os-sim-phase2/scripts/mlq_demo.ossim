# ─────────────────────────────────────────────────────────────────────────────
#  Multilevel Queue (MLQ) Demo
#
#  Queue assignment by priority:
#    Level 0  System       (priority 0–1)  — FCFS
#    Level 1  Interactive  (priority 2–4)  — Round Robin Q=4
#    Level 2  Batch        (priority 5+)   — FCFS
# ─────────────────────────────────────────────────────────────────────────────

# System processes (highest priority, FCFS within level)
proc add SysInit    0  3 0
proc add SysDaemon  0  2 1

# Interactive processes (Round Robin Q=4)
proc add Terminal   1  8 2
proc add Editor     1 12 3
proc add Browser    2  6 4

# Batch processes (lowest priority, FCFS)
proc add Compile    0 20 5
proc add Backup     0 30 8

proc list

sched set mlq
sched run

# Compare MLQ vs plain FCFS and Priority to highlight the difference
compare mlq fcfs priority --quantum 4
